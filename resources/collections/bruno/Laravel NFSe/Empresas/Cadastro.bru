meta {
  name: Cadastro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/companies
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  name: {{companyName}}
  certificate: @file(C:\certificates\cert.pfx)
  cert_password: {{certificatePassword}}
}

settings {
  encodeUrl: true
  timeout: 0
}
